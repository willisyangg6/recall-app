ource srcset=\"/files/styles/recall_image_small/public/3_0.jpeg?itok=Q0xg6SKy 400w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"400\" height=\"533\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/3_0.jpeg?itok=Q0xg6SKy 400w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"400\" height=\"533\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/3_0.jpeg?itok=Yayu_wIo 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/3_0.jpeg?itok=Yayu_wIo 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/3_0.jpeg?itok=Yayu_wIo 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/3_0.jpeg?itok=Yayu_wIo 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/3_0.jpeg?itok=Q0xg6SKy\" width=\"400\" height=\"533\" alt=\"Wegmans Deluxe Mixed Nuts Unsalted 11.5 oz (326 grams) bag\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/4.jpeg?itok=S-uGegtQ 391w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"391\" height=\"5
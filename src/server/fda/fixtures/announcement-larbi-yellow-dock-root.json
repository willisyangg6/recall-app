  "mainHtml": "<main>\n\n                                 <article id=\"main-content\" class=\"article main-content container-fluid\" role=\"article\">\n          \n                                                                <header class=\"row content-header\">\n                         <section id=\"block-entityviewcontent-7\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n<div class=\"col-sm-12 col-md-8 col-md-offset-2\">\n\n          <p class=\"content-type-label text-center\">COMPANY ANNOUNCEMENT</p>\n    \n  \n  \n  <h1 class=\"content-title text-center\">Larbi Inc. Recalls Yellow Dock Root Because of Possible Health Risk</h1>\n\n  \n    \n        <div class=\"alert alert-danger text-center col-xs-12\" id=\"disclaimer\">\n      <p>When a company announces a recall, market withdrawal, or safety alert, the FDA posts the company's announcement as a public service. FDA does not endorse either the product or the company.</p>\n      <a class=\"btn btn-default\" href=\"#recall-announcement\">Read Announcement</a> <a class=\"btn btn-default\" href=\"#recall-photos\">View Product Photos</a> \n    </div>\n  \n  \n \n</div>\n \n  </section>\n\n\n\n\n\n\n                      </header>\n                              \n                                                          \n                              <aside class=\"col-md-2\" role=\"complementary\">\n                  <section id=\"block-entityviewcontent-3\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n        <div class=\"region region-\">\n    <p class=\"text-center \"><a href=\"/safety/recalls-market-withdrawals-safety-alerts\" class=\"btn btn-default\"><i class=\"fa fa-arrow-circle-left\" aria-hidden=\"true\"></i> More Recalls, Market <br>\n    Withdrawals, & <br>\n    Safety Alerts</a></p>\n\n        <nav id=\"section-nav\"class=\"lcds-card lcds-section-nav lcds-section-nav--side hidden-xs hidden-sm\">\n      <ul class=\"lcds-section-nav__list lcds-section-nav--side__list\">\n        <li>\n\n                    <a href=\"/safety/recalls-market-withdrawals-safety-alerts\" title=\"Recalls, Market Withdrawals, &amp; Safety Alerts\" class=\"lcds-section-nav__link lcds-section-nav--side__link lcds-section-nav__parent-link lcds-section-nav--side__parent-link\">\n                                        Recalls, Market Withdrawals, &amp; Safety Alerts\n                      </a>\n\n          \n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section view-id-in_this_section view-display-id-block_4 js-view-dom-id-4145a1bf57ef56768cdd00864b43da595c9474c4c3f7249334e6c7bc9f140193\">\n  \n    \n      \n  \n      <div class=\"item-list\">\n  \n  <ul class=\"lcds-section-nav__active lcds-section-nav__list lcds-section-nav--side__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/recall-resources\" class=\"lcds-section-nav__link lcds-section-nav--side__link\">Recall Resources </a></li>\n    \n  </ul>\n\n</div>\n\n\n  \n          </div>\n</div>\n\n\n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section-sub view-id-in_this_section_sub view-display-id-block_1 js-view-dom-id-1a9ad3ec9c4800c0ed6f824666988cbfddc98bbabffe075543e2612bc040b037\">\n  \n    \n      \n      <div class=\"view-content\">\n      <div>\n  \n  <ul class=\"lcds-section-nav__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/enforcement-reports\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Enforcement Reports</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/industry-guidance-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Industry Guidance For Recalls</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/major-product-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Major Product Recalls</a></li>\n    \n  </ul>\n\n</div>\n\n    </div>\n  \n          </div>\n</div>\n\n\n        </li>\n      </ul>\n    </nav>\n  </div>\n\n  </section>\n\n\n                </aside>\n              \n                                                          \n              <div class=\"col-md-8\" role=\"main\">\n\n                            \n                            \n                            \n                            \n                                              \n  <h2>Summary</h2>\n\n  <div class=\"inset-column\">\n    <dl class=\"lcds-description-list--grid\">\n            <dt class=\"cell-1_1\">Company Announcement Date:</dt>\n             <dd class=\"cell-2_1\"><time datetime=\"2026-11-17T23:30:00Z\">November 17, 2026</time>\n</dd>\n\n                          <dt class=\"cell-1_2\">FDA Publish Date:</dt> \n               <dd class=\"cell-2_2\"><time datetime=\"2026-11-17T05:00:00Z\">November 17, 2026</time>\n</dd>\n                                    <dt class=\"cell-1_3\">Product Type:</dt> \n              <dd class=\"cell-2_3\">Food &amp; Beverages                          \n            \n            \n            \n            \n            \n            \n            \n              \n              <br/>Foodborne Illness\n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          \n            \n            \n            \n              \n            \n            \n                          </dd>\n                          <dt class=\"cell-1_4\">Reason for Announcement:</dt>\n              <dd class=\"cell-2_4\">\n  <div class=\"field field--name-field-recall-reason-description field--type-string field--label-above\">\n    <div class=\"field--label\">Recall Reason Description</div>\n              <div class=\"field--item\">Potential to be contaminated with Salmonella</div>\n          </div>\n</dd>\n\n            <dt class=\"cell-1_5\">Company Name:</dt> \n              <dd class=\"cell-2_5\">  Larbi Inc.</dd>\n\n            <dt class=\"cell-1_6\">Brand Name:</dt>\n              <dd class=\"cell-2_6\">\n  <div class=\"field field--name-field-brand-name field--type-entity-reference field--label-inline\">\n    <div class=\"field--label\">Brand Name(s)</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Herb to Body</div>\n              </div>\n      </div>\n</dd>\n\n            <dt class=\"cell-1_7\">Product Description:</dt>\n              <dd class=\"cell-2_7\">\n  <div class=\"field field--name-field-product-description field--type-string field--label-above\">\n    <div class=\"field--label\">Product Description</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">  Yellow Dock Root C/S</div>\n              </div>\n      </div>\n</dd> \n        </dl>\n      </div>   \n<hr>\n\n  <h2 id=\"recall-announcement\">Company Announcement</h2>\n\n\n\n<p>Larbi Inc. of Valley Cottage, NY, is recalling three lots of Herb To Body Yellow Dock Root C/S 4oz, because it has the potential to be contaminated with <em>Salmonella</em>, an organism which can cause serious and sometimes fatal infections in young children, frail or elderly people, and others with weakened immune systems. Healthy persons infected with <em>Salmonella</em> often experience fever, diarrhea (which may be bloody), nausea, vomiting and abdominal pain. In rare circumstances, infection with <em>Salmonella</em> can result in the organism getting into the bloodstream and producing more severe illnesses such as arterial infections (i.e., infected aneurysms), endocarditis and arthritis.</p><p>The product was sold nationwide between January 2026 and November 2026 through the company's website, herbtobody.com, through third-party online marketplaces, and through retail stores.</p><p>Herb To Body Yellow Dock Root C/S 4oz comes in a 4 oz pouch, with the lot number printed below the barcode on the back label.</p><p>The recalled lots are:</p><ul><li>HB02223</li><li>HB02474</li><li>HB02848</li></ul><p>No other lots or products are affected.</p><p>No illnesses have been reported to date.</p><p>The recall was initiated after the company's ingredient supplier notified Larbi Inc. that an ingredient lot used to make these products may be contaminated with <em>Salmonella</em>. Larbi Inc. has stopped distribution of the recalled lots and is working with its supplier and the FDA.</p><p>Consumers who have this product should not consume it and should discard it for a full refund or with questions, contact Herb To Body Customer Care at 914-713-5226, Monday through Friday, 9 AM to 5 PM Eastern Time, or <a href=\"mailto:care@herbtobody.com\">care@herbtobody.com</a>.</p>\n\n\n\n\n<div class=\"inset-column\">\n      <hr>\n    <h2>Company Contact Information</h2>\n  \n  \n    <div class=\"row\">\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n          <dt>Consumers:</dt>       \n\n                 <dd>Herb To Body Customer Care</dd>\n        \n                 <dd><span class=\"fa fa-phone\" aria-hidden=\"true\"></span> 914-713-5226</dd>\n        \n                 <dd><span class=\"fa fa-envelope\" aria-hidden=\"true\"></span><a href=\"mailto:care@herbtobody.com\"> care@herbtobody.com</a></dd>\n        \n        \n\n      </dl>\n    </div>\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n\n              <dt>Media:</dt>\n      \n              <dd>Wess Messad </dd>\n      \n              <dd><span class=\"fa fa-phone\" aria-hidden=\"true\"></span> 914-713-5226</dd>\n      \n      \n      </dl>\n    </div>\n  </div>\n  </div>\n\n\n\n  <hr>\n  <div id=\"recall-photos\" class=\"recall-photos lazy-load\">\n    <h2>Product Photos</h2>\n\n            <ul class=\"list-unstyled nav-stacked\">\n        \n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/image_1_266.png?itok=cHaWhbwu 294w\" media=\"all and (max-width: 320px)\" type=\"image/png\" sizes=\"100vw\" width=\"294\" height=\"456\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/image_1_266.png?itok=cHaWhbwu 294w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/png\" sizes=\"100vw\" width=\"294\" height=\"456\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_1_266.png?itok=X6EZuGn5 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1582\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_1_266.png?itok=X6EZuGn5 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1582\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_1_266.png?itok=X6EZuGn5 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1582\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_1_266.png?itok=X6EZuGn5 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1582\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/image_1_266.png?itok=cHaWhbwu\" width=\"294\" height=\"456\" alt=\"Front of pouch\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/image_2_208.png?itok=sv6kHjle 370w\" media=\"all and (max-width: 320px)\" type=\"image/png\" sizes=\"100vw\" width=\"370\" height=\"564\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/image_2_208.png?itok=sv6kHjle 370w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/png\" sizes=\"100vw\" width=\"370\" height=\"564\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_2_208.png?itok=0Ef1adPt 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1555\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_2_208.png?itok=0Ef1adPt 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1555\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_2_208.png?itok=0Ef1adPt 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1555\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/image_2_208.png?itok=0Ef1adPt 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1555\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/image_2_208.png?itok=sv6kHjle\" width=\"370\" height=\"564\" alt=\"Back label, showing the lot number below the barcode\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n\n      </ul>\n      \n  </div>\n\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n\n\n\n              \n                                            \n              \n            </div>\n\n                                                  \n                          <aside class=\"col-md-2\" role=\"complementary\">\n                <section id=\"block-entityviewcontent-4\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n\n  <div class=\"region region-\">\n  <aside class=\"lcds-card lcds-card--border-top\">\n    <ul role=\"menu\" class=\"lcds-description-list\">\n      \n                            \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  <li role=\"menuitem\" class=\"node-current-date lcds-description-list__item\">\n    <div>\n      <h2 class=\"lcds-description-list__item-heading\">Content current as of:</h2>\n      <p class=\"lcds-description-list__item-text\"><time datetime=\"2026-11-17T00:00:00Z\">11/17/2026</time>\n</p>\n    </div>\n  </li>\n               \n             \n<li role=\"menuitem\" class=\"lcds-description-list__item\">  \n\t<div>\n\t\t\n\t\t <h2 class=\"lcds-description-list__item-heading\">Regulated Product(s)</h2>\n\t\t <ul role=\"menu\" class=\"lcds-metadata-list\">\n\t\t\t\t\t\t  <li role=\"menuitem\">Food &amp; Beverages</li>\n\t\t\t  \t\t\t     \t\t\t  \t\t\t\t\t\t              \n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t</ul>\n\t \n\t\t\t     \n\t\t\t \n\n\t\t\t  <h2 class=\"lcds-description-list__item-heading\">Topic(s)</h2>\n\t\t\t  <ul role=\"menu\" class=\"lcds-metadata-list\">\n\t\t\t  \t\t\n\t\t\t\t  \n\t\t\t\t  \n\t\t\t\t   \n\t\t\t\t  <li role=\"menuitem\">Foodborne Illness</li>\n\t\t\t\t  \t\t\t\t     \t\t\t\t  \t\t\t\t  \
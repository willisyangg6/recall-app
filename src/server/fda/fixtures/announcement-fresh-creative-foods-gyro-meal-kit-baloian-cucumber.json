itok=aonGSCt8\" width=\"480\" height=\"298\" alt=\"Beef &amp; Lamb Gyro Sandwich Express Meal Kit, use by date of 12/24/2024 – 1/6/2025 (showing 12/24/2024)\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=31Z-W8aA 480w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"396\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=31Z-W8aA 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"396\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=EnrJTUmt 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"841\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=EnrJTUmt 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"841\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=EnrJTUmt 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"841\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=EnrJTUmt 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"841\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/beef_lamb_gyro_sandwich_express_meal_kit_upc.jpg?itok=31Z-W8aA\" width=\"480\" height=\"396\" alt=\"Beef &amp; Lamb Gyro Sandwich Express Meal Kit, back label UPC: 0-13454-38313-1\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n\n      </ul>\n      \n  </div>\n\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n\n\n\n              \n                                            \n              \n            </div>\n\n                                                  \n                          <aside class=\"col-md-2\" role=\"complementary\">\n                <section id=\"block-entityviewcontent-4\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n\n  <div class=\"region region-\">\n  <aside class=\"lcds-card lcds-card--border-top\">\n    <ul role=\"menu\" class=\"lcds-description-list\">\n      \n                            \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  <li role=\"menuitem\" class=\"node-current-date lcds-description-list__item\">\n    <div>\n      <h2 class=\"lcds-description-list__item-heading\">Content current as of:</h2>\n      <p class=\"lcds-description-list__item-text\"><time datetime=\"2024-12-06T00:00:00Z\">12/06/2024</time>\n</p>\n    </div>\n  </li>\n               \n             \n<li role=\"menuitem\" class=\"lcds-description-list__item\">  \n\t<div>\n\t\t\n\t\t <h2 class=\"lcds-description-list__item-heading\">Regulated Product(s)</h2>\n\t\t <ul role=\"menu\" class=\"lcds-metadata-list\">\n\t\t\t\t\t\t  <li role=\"menuitem\">Food &amp; Beverages</li>\n\t\t\t  \t\t\t     \t\t\t  \t\t\t\t\t\t              \n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t</ul>\n\t \n\t\t\t     \n\t\t\t\t\t\t       \n\n\t\t\t  \n\t\t\t\t\t\t  \n\n\t\t\t 
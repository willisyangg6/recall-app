 "mainHtml": "<main>\n\n                                 <article id=\"main-content\" class=\"article main-content container-fluid\" role=\"article\">\n          \n                                                                <header class=\"row content-header\">\n                         <section id=\"block-entityviewcontent-7\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n<div class=\"col-sm-12 col-md-8 col-md-offset-2\">\n\n          <p class=\"content-type-label text-center\">COMPANY ANNOUNCEMENT</p>\n    \n  \n  \n  <h1 class=\"content-title text-center\">Jaime’s Foods ATX Issues Allergy Alert on Undeclared Egg Allergen in Jaime’s Spanish Village Jalapeno Ranch</h1>\n\n  \n    \n        <div class=\"alert alert-danger text-center col-xs-12\" id=\"disclaimer\">\n      <p>When a company announces a recall, market withdrawal, or safety alert, the FDA posts the company's announcement as a public service. FDA does not endorse either the product or the company.</p>\n      <a class=\"btn btn-default\" href=\"#recall-announcement\">Read Announcement</a> <a class=\"btn btn-default\" href=\"#recall-photos\">View Product Photos</a> \n    </div>\n  \n  \n \n</div>\n \n  </section>\n\n\n\n\n\n\n                      </header>\n                              \n                                                          \n                              <aside class=\"col-md-2\" role=\"complementary\">\n                  <section id=\"block-entityviewcontent-3\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n        <div class=\"region region-\">\n    <p class=\"text-center \"><a href=\"/safety/recalls-market-withdrawals-safety-alerts\" class=\"btn btn-default\"><i class=\"fa fa-arrow-circle-left\" aria-hidden=\"true\"></i> More Recalls, Market <br>\n    Withdrawals, & <br>\n    Safety Alerts</a></p>\n\n        <nav id=\"section-nav\"class=\"lcds-card lcds-section-nav lcds-section-nav--side hidden-xs hidden-sm\">\n      <ul class=\"lcds-section-nav__list lcds-section-nav--side__list\">\n        <li>\n\n                    <a href=\"/safety/recalls-market-withdrawals-safety-alerts\" title=\"Recalls, Market Withdrawals, &amp; Safety Alerts\" class=\"lcds-section-nav__link lcds-section-nav--side__link lcds-section-nav__parent-link lcds-section-nav--side__parent-link\">\n                                        Recalls, Market Withdrawals, &amp; Safety Alerts\n                      </a>\n\n          \n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section view-id-in_this_section view-display-id-block_4 js-view-dom-id-fbf8eb1621cdcdfd6c7e20499b5d95964fafc97968d5cf8446d70968fc87682e\">\n  \n    \n      \n  \n      <div class=\"item-list\">\n  \n  <ul class=\"lcds-section-nav__active lcds-section-nav__list lcds-section-nav--side__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/recall-resources\" class=\"lcds-section-nav__link lcds-section-nav--side__link\">Recall Resources </a></li>\n    \n  </ul>\n\n</div>\n\n\n  \n          </div>\n</div>\n\n\n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section-sub view-id-in_this_section_sub view-display-id-block_1 js-view-dom-id-9bdf1c7bfb4b25ce264e71f119e1ba50751d3d941f9e72e41bf987e517d9f423\">\n  \n    \n      \n      <div class=\"view-content\">\n      <div>\n  \n  <ul class=\"lcds-section-nav__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/enforcement-reports\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Enforcement Reports</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/industry-guidance-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Industry Guidance For Recalls</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/major-product-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Major Product Recalls</a></li>\n    \n  </ul>\n\n</div>\n\n    </div>\n  \n          </div>\n</div>\n\n\n        </li>\n      </ul>\n    </nav>\n  </div>\n\n  </section>\n\n\n                </aside>\n              \n                                                          \n              <div class=\"col-md-8\" role=\"main\">\n\n                            \n                            \n                            \n                            \n                                              \n  <h2>Summary</h2>\n\n  <div class=\"inset-column\">\n    <dl class=\"lcds-description-list--grid\">\n            <dt class=\"cell-1_1\">Company Announcement Date:</dt>\n             <dd class=\"cell-2_1\"><time datetime=\"2026-08-25T14:22:00Z\">August 25, 2026</time>\n</dd>\n\n                          <dt class=\"cell-1_2\">FDA Publish Date:</dt> \n               <dd class=\"cell-2_2\"><time datetime=\"2026-08-26T04:00:00Z\">August 26, 2026</time>\n</dd>\n                                    <dt class=\"cell-1_3\">Product Type:</dt> \n              <dd class=\"cell-2_3\">Food &amp; Beverages                          \n            \n            \n            \n            \n            \n            \n            \n              \n              <br/>Allergens\n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          \n            \n            \n            \n              \n            \n            \n                          </dd>\n                          <dt class=\"cell-1_4\">Reason for Announcement:</dt>\n              <dd class=\"cell-2_4\">\n  <div class=\"field field--name-field-recall-reason-description field--type-string field--label-above\">\n    <div class=\"field--label\">Recall Reason Description</div>\n              <div class=\"field--item\">contains undeclared eggs</div>\n          </div>\n</dd>\n\n            <dt class=\"cell-1_5\">Company Name:</dt> \n              <dd class=\"cell-2_5\">Jaime’s Foods ATX</dd>\n\n            <dt class=\"cell-1_6\">Brand Name:</dt>\n              <dd class=\"cell-2_6\">\n  <div class=\"field field--name-field-brand-name field--type-entity-reference field--label-inline\">\n    <div class=\"field--label\">Brand Name(s)</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Jaime’s Spanish Village</div>\n              </div>\n      </div>\n</dd>\n\n            <dt class=\"cell-1_7\">Product Description:</dt>\n              <dd class=\"cell-2_7\">\n  <div class=\"field field--name-field-product-description field--type-string field--label-above\">\n    <div class=\"field--label\">Product Description</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Jalapeno Ranch Dressing</div>\n              </div>\n      </div>\n</dd> \n        </dl>\n      </div>   \n<hr>\n\n  <h2 id=\"recall-announcement\">Company Announcement</h2>\n\n\n\n<p><strong>Jaime’s Foods ATX</strong> of <strong>Austin, TEXAS</strong> is recalling <strong>Jaime’s Spanish Village Jalapeno Ranch</strong> because it contains undeclared eggs. People who have an allergy or severe sensitivity to eggs run the risk of serious or life-threatening allergic reaction if they consume this product.</p><p>The product was sold at Central Market retail stores in Texas and local independent retailers in Austin, Texas beginning on April 3, 2026.</p><p>The recalled Jaime’s Spanish Village Jalapeno Ranch dressing is packed in 16 oz (45.5g) glass jars with UPC #199284564923. Recalled lot numbers include the following: 69, 86, 108, 113, 116, and 121. The lot code can be found stamped on the bottom of the jar.</p><p>No illnesses have been reported to date.</p><p>The recall was initiated after it was discovered that the allergen eggs was left off the ingredient list and allergen warning for the recalled cases of product. This omission was discovered during an FDA inspection of the facility where the product is bottled.</p><p>Consumers who have purchased Jaime’s Spanish Village Jalapeno Ranch may return it to the place of purchase for a full refund. Consumers with questions may contact the company at 1-855-833-1442, or via email at <a href=\"mailto:info@jaimessalsas.com\">info@jaimessalsas.com</a>. Consumers will receive a response within 12 hours.</p>\n\n\n\n\n<div class=\"inset-column\">\n      <hr>\n    <h2>Company Contact Information</h2>\n  \n  \n    <div class=\"row\">\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n          <dt>Consumers:</dt>       \n\n        \n                 <dd><span class=\"fa fa-phone\" aria-hidden=\"true\"></span> 1-855-833-1442</dd>\n        \n                 <dd><span class=\"fa fa-envelope\" aria-hidden=\"true\"></span><a href=\"mailto:info@jaimessalsas.com\"> info@jaimessalsas.com</a></dd>\n        \n        \n\n      </dl>\n    </div>\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n\n      \n      \n      \n      \n      </dl>\n    </div>\n  </div>\n  </div>\n\n\n\n  <hr>\n  <div id=\"recall-photos\" class=\"recall-photos lazy-load\">\n    <h2>Product Photos</h2>\n\n            <ul class=\"list-unstyled nav-stacked\">\n        \n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/jamoe11_0.png?itok=LD6EOmbR 480w\" media=\"all and (max-width: 320px)\" type=\"image/png\" sizes=\"100vw\" width=\"480\" height=\"480\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/jamoe11_0.png?itok=LD6EOmbR 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/png\" sizes=\"100vw\" width=\"480\" height=\"480\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamoe11_0.png?itok=JFcxEYWG 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1020\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamoe11_0.png?itok=JFcxEYWG 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1020\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamoe11_0.png?itok=JFcxEYWG 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1020\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamoe11_0.png?itok=JFcxEYWG 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"1020\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/jamoe11_0.png?itok=LD6EOmbR\" width=\"480\" height=\"480\" alt=\"Jaimes Spanish Village Jalapeno Ranch Front Panel Label\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/jamie2.jpeg.png?itok=PiUX4ZII 480w\" media=\"all and (max-width: 320px)\" type=\"image/png\" sizes=\"100vw\" width=\"480\" height=\"125\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/jamie2.jpeg.png?itok=PiUX4ZII 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/png\" sizes=\"100vw\" width=\"480\" height=\"125\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamie2.jpeg.png?itok=_CZq_WYA 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"266\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamie2.jpeg.png?itok=_CZq_WYA 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"266\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamie2.jpeg.png?itok=_CZq_WYA 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"266\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/jamie2.jpeg.png?itok=_CZq_WYA 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/png\" sizes=\"100vw\" width=\"1020\" height=\"266\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/jamie2.jpeg.png?itok=PiUX4ZII\" width=\"480\" height=\"125\" alt=\"Jaimes Spanish Village Jalapeno Ranch Full Labeling\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n\n      </ul>\n      \n  </div>\n\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n\n\n\n              \n                                            \n              \n            </div>\n\n                                                  \n                          <aside class=\"col-md-2\" role=\"complementary\">\n                <section id=\"block-entityviewcontent-4
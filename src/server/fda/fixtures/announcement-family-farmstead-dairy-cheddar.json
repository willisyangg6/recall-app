  "mainHtml": "<main>\n\n                                 <article id=\"main-content\" class=\"article main-content container-fluid\" role=\"article\">\n          \n                                                                <header class=\"row content-header\">\n                         <section id=\"block-entityviewcontent-7\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n<div class=\"col-sm-12 col-md-8 col-md-offset-2\">\n\n          <p class=\"content-type-label text-center\">COMPANY ANNOUNCEMENT</p>\n    \n  \n  \n  <h1 class=\"content-title text-center\">Family Farmstead Dairy Announces Recall of All Cheddar Cheese Products Because of Possible Health Risk</h1>\n\n  \n    \n        <div class=\"alert alert-danger text-center col-xs-12\" id=\"disclaimer\">\n      <p>When a company announces a recall, market withdrawal, or safety alert, the FDA posts the company's announcement as a public service. FDA does not endorse either the product or the company.</p>\n      <a class=\"btn btn-default\" href=\"#recall-announcement\">Read Announcement</a> <a class=\"btn btn-default\" href=\"#recall-photos\">View Product Photos</a> \n    </div>\n  \n  \n \n</div>\n \n  </section>\n\n\n\n\n\n\n                      </header>\n                              \n                                                          \n                              <aside class=\"col-md-2\" role=\"complementary\">\n                  <section id=\"block-entityviewcontent-3\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n        <div class=\"region region-\">\n    <p class=\"text-center \"><a href=\"/safety/recalls-market-withdrawals-safety-alerts\" class=\"btn btn-default\"><i class=\"fa fa-arrow-circle-left\" aria-hidden=\"true\"></i> More Recalls, Market <br>\n    Withdrawals, & <br>\n    Safety Alerts</a></p>\n\n        <nav id=\"section-nav\"class=\"lcds-card lcds-section-nav lcds-section-nav--side hidden-xs hidden-sm\">\n      <ul class=\"lcds-section-nav__list lcds-section-nav--side__list\">\n        <li>\n\n                    <a href=\"/safety/recalls-market-withdrawals-safety-alerts\" title=\"Recalls, Market Withdrawals, &amp; Safety Alerts\" class=\"lcds-section-nav__link lcds-section-nav--side__link lcds-section-nav__parent-link lcds-section-nav--side__parent-link\">\n                                        Recalls, Market Withdrawals, &amp; Safety Alerts\n                      </a>\n\n          \n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section view-id-in_this_section view-display-id-block_4 js-view-dom-id-6d50016dff855d3869212d77051ad2c95bbc1fa92bbb631a815b3d3d0e25aad3\">\n  \n    \n      \n  \n      <div class=\"item-list\">\n  \n  <ul class=\"lcds-section-nav__active lcds-section-nav__list lcds-section-nav--side__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/recall-resources\" class=\"lcds-section-nav__link lcds-section-nav--side__link\">Recall Resources </a></li>\n    \n  </ul>\n\n</div>\n\n\n  \n          </div>\n</div>\n\n\n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section-sub view-id-in_this_section_sub view-display-id-block_1 js-view-dom-id-274040e5fd4d37f83f39293694df30114402f55428ff7f9214bf0eca481cee2a\">\n  \n    \n      \n      <div class=\"view-content\">\n      <div>\n  \n  <ul class=\"lcds-section-nav__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/enforcement-reports\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Enforcement Reports</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/industry-guidance-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Industry Guidance For Recalls</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/major-product-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Major Product Recalls</a></li>\n    \n  </ul>\n\n</div>\n\n    </div>\n  \n          </div>\n</div>\n\n\n        </li>\n      </ul>\n    </nav>\n  </div>\n\n  </section>\n\n\n                </aside>\n              \n                                                          \n              <div class=\"col-md-8\" role=\"main\">\n\n                            \n                            \n                            \n                            \n                                              \n  <h2>Summary</h2>\n\n  <div class=\"inset-column\">\n    <dl class=\"lcds-description-list--grid\">\n            <dt class=\"cell-1_1\">Company Announcement Date:</dt>\n             <dd class=\"cell-2_1\"><time datetime=\"2026-10-15T04:00:00Z\">October 15, 2026</time>\n</dd>\n\n                          <dt class=\"cell-1_2\">FDA Publish Date:</dt> \n               <dd class=\"cell-2_2\"><time datetime=\"2026-11-10T05:00:00Z\">November 10, 2026</time>\n</dd>\n                                    <dt class=\"cell-1_3\">Product Type:</dt> \n              <dd class=\"cell-2_3\">Food &amp; Beverages                          \n            \n            \n            \n            \n            \n            \n            \n             \n            \n            \n            \n              \n            \n            \n                          </dd>\n                          <dt class=\"cell-1_4\">Reason for Announcement:</dt>\n              <dd class=\"cell-2_4\">\n  <div class=\"field field--name-field-recall-reason-description field--type-string field--label-above\">\n    <div class=\"field--label\">Recall Reason Description</div>\n              <div class=\"field--item\">Potential to be contaminated with Listeria monocytogenes.</div>\n          </div>\n</dd>\n\n            <dt class=\"cell-1_5\">Company Name:</dt> \n              <dd class=\"cell-2_5\">Family Farmstead Dairy</dd>\n\n            <dt class=\"cell-1_6\">Brand Name:</dt>\n              <dd class=\"cell-2_6\">\n  <div class=\"field field--name-field-brand-name field--type-entity-reference field--label-inline\">\n    <div class=\"field--label\">Brand Name(s)</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Family Farmstead</div>\n              </div>\n      </div>\n</dd>\n\n            <dt class=\"cell-1_7\">Product Description:</dt>\n              <dd class=\"cell-2_7\">\n  <div class=\"field field--name-field-product-description field--type-string field--label-above\">\n    <div class=\"field--label\">Product Description</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Raw Mild Cheddar; Raw Sharp Cheddar</div>\n              </div>\n      </div>\n</dd> \n        </dl>\n      </div>   \n<hr>\n\n  <h2 id=\"recall-announcement\">Company Announcement</h2>\n\n\n\n<p><strong>Worcester, New York –</strong> Family Farmstead Dairy is recalling all cheddar cheese products because it has the potential to be contaminated with <em>Listeria monocytogenes</em>, an organism which can cause serious and sometimes fatal infections in young children, frail or elderly people, and others with weakened immune systems. Although healthy individuals may suffer only short-term symptoms such as high fever, severe headache, stiffness, nausea, abdominal pain and diarrhea, <em>Listeria </em>infection can cause miscarriages and stillbirths among pregnant women.</p><p>This decision follows the company's October 15, 2026 recall of certain raw cheddar products due to potential contamination with <em>E. Coli O26:H11</em> and <em>O45:H2</em></p><p>Product was distributed in NY, NJ, VT, NH, MA, PA, RI, CT, DE, VA, WV, and TN through retail stores.</p><p><strong>Products Affected</strong></p><div class=\"inset-column\"><div class=\"table-responsive\"><table class=\"table table-bordered table-striped table-condensed\"><thead><tr><th scope=\"col\"><p class=\"text-align-center\"><strong>Product Description</strong></p></th><th scope=\"col\"><p class=\"text-align-center\"><strong>Lot Code/Best By Date</strong></p></th></tr></thead><tbody><tr><td>Raw Mild Cheddar, 8oz, plastic wrapped</td><td>All lot codes dated 10/16/27 and prior</td></tr><tr><td>Raw Sharp Cheddar, 8oz, plastic wrapped</td><td>All lot codes dated 10/16/27 and prior</td></tr></tbody></table></div></div><p>No other Family Farmstead Dairy products are included in this recall unless specifically identified by the company.</p><p><strong>Consumer Information&nbsp;</strong><br>Consumers who have purchased affected cheddar products may return them to the place of purchase or contact Family Farmstead Dairy directly for assistance.</p><p>This action is being taken as part of our ongoing commitment to continuous improvement and product excellence. Due to the potential of contamination, all Cheddar products with an expiration date of 10/16/27 and prior is being recalled at this time.</p><p><strong>Questions regarding this recall may be directed to:</strong><br>Family Farmstead Dairy Phone: (607) 397-4044 (M-F, 8:00-5:00) Email: <a href=\"mailto:customerservice@familyfarmsteaddairy.com\">customerservice@familyfarmsteaddairy.com</a> Family Farmstead Dairy appreciates the cooperation of its distributors, retailers, and customers and apologizes for any inconvenience this action may cause. The company remains committed to producing safe, high-quality dairy products and maintaining the trust of the communities it serves.</p><p><strong>About Family Farmstead Dairy&nbsp;</strong><br>Family Farmstead Dairy is committed to producing high-quality dairy products while maintaining rigorous standards for food safety, product quality, and continuous improvement throughout its operations.</p>\n\n\n\n\n<div class=\"inset-column\">\n      <hr>\n    <h2>Company Contact Information</h2>\n  \n  \n    <div class=\"row\">\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n          <dt>Consumers:</dt>       \n\n        \n                 <dd><span class=\"fa fa-phone\" aria-hidden=\"true\"></span> (607) 397-4044 </dd>\n        \n                 <dd><span class=\"fa fa-envelope\" aria-hidden=\"true\"></span><a href=\"mailto:customerservice@familyfarmsteaddairy.com\"> customerservice@familyfarmsteaddairy.com</a></dd>\n        \n        \n\n      </dl>\n    </div>\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n\n      \n      \n      \n      \n      </dl>\n    </div>\n  </div>\n  </div>\n\n\n\n  <hr>\n  <div id=\"recall-photos\" class=\"recall-photos lazy-load\">\n    <h2>Product Photos</h2>\n\n            <ul class=\"list-unstyled nav-stacked\">\n        \n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/raw1.jpg?itok=QzI6oZGf 480w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"361\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/raw1.jpg?itok=QzI6oZGf 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"361\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw1.jpg?itok=BLNDex0m 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw1.jpg?itok=BLNDex0m 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw1.jpg?itok=BLNDex0m 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw1.jpg?itok=BLNDex0m 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/raw1.jpg?itok=QzI6oZGf\" width=\"480\" height=\"361\" alt=\"Front label panel for Family Farmstead Raw Cheddar, 8 oz.\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/raw2.jpg?itok=Qp5hi-Ma 480w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"360\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/raw2.jpg?itok=Qp5hi-Ma 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"360\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw2.jpg?itok=zha4zF8- 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw2.jpg?itok=zha4zF8- 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw2.jpg?itok=zha4zF8- 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/raw2.jpg?itok=zha4zF8- 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"766\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/raw2.jpg?itok=Qp5hi-Ma\" width=\"480\" height=\"360\" alt=\"Back label panel for Family Farmstead Raw Cheddar with Best By Date, 8oz.\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n\n      </ul>\n      \n  </div>\n\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n\n\n\n              \n                                            \n              \n            </div>\n\n                                                  \n                          <aside class=\"col-md-2\" role=\"complementary\">\n                <section id=\"block-entityviewcontent-4\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n\n  <div class=\"region region-\">\n  <aside class=\"lcds-card lcds-card--border-top\">\n    <ul role=\"menu\" class=\"lcds-description-list\">\n      \n                            \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  <li role=\"menuitem\" class=\"node-current-date lcds-description-list__item\">\n    <div>\n      <h2 class=\"lcds-description-list__item-heading\">Content current as of:</h2>\n      <p class=\"lcds-description-list__item-text\"><time datetime=\"2026-11-10T00:00:00Z\">11/10/2026</time>\n</p>\n    </div>\n  </li>\n               \n             \n<li role=\"menuitem\" class=\"lcds-description-list__item\">  \n\t<div>\n\t\t\n\t\t <h2 class=\"lcds-description-list__item-heading\">Regulated Product(s)</h2>\n\t\t <ul role=\"menu\" class=\"lcds-metadata-list\">\n\t\t\t\t\t\t  <li role=\"menuitem\">Food &amp; Beverages</li>\n\t\t\t  \t\t\t     \t\t\t  \t\t\t\t\t\t              \n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\
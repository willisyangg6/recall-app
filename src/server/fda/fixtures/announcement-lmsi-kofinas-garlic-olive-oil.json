 "mainHtml": "<main>\n\n                                 <article id=\"main-content\" class=\"article main-content container-fluid\" role=\"article\">\n          \n                                                                <header class=\"row content-header\">\n                         <section id=\"block-entityviewcontent-7\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n      \n<div class=\"col-sm-12 col-md-8 col-md-offset-2\">\n\n          <p class=\"content-type-label text-center\">COMPANY ANNOUNCEMENT</p>\n    \n  \n  \n  <h1 class=\"content-title text-center\">LMSI LLC/Kofinas Olive Oil Issues a Voluntary Recall of its Garlic Mediterranean Infused Extra Virgin Olive Oil for Using a Garlic Essential Oil Not Approved for Culinary Use</h1>\n\n  \n    \n        <div class=\"alert alert-danger text-center col-xs-12\" id=\"disclaimer\">\n      <p>When a company announces a recall, market withdrawal, or safety alert, the FDA posts the company's announcement as a public service. FDA does not endorse either the product or the company.</p>\n      <a class=\"btn btn-default\" href=\"#recall-announcement\">Read Announcement</a> <a class=\"btn btn-default\" href=\"#recall-photos\">View Product Photos</a> \n    </div>\n  \n  \n \n</div>\n \n  </section>\n\n\n\n\n\n\n                      </header>\n                              \n                                                          \n                              <aside class=\"col-md-2\" role=\"complementary\">\n                  <section id=\"block-entityviewcontent-3\" data-block-plugin-id=\"entity_view:node\" class=\"block block-ctools block-entity-viewnode clearfix\">\n  \n    \n\n        <div class=\"region region-\">\n    <p class=\"text-center \"><a href=\"/safety/recalls-market-withdrawals-safety-alerts\" class=\"btn btn-default\"><i class=\"fa fa-arrow-circle-left\" aria-hidden=\"true\"></i> More Recalls, Market <br>\n    Withdrawals, & <br>\n    Safety Alerts</a></p>\n\n        <nav id=\"section-nav\"class=\"lcds-card lcds-section-nav lcds-section-nav--side hidden-xs hidden-sm\">\n      <ul class=\"lcds-section-nav__list lcds-section-nav--side__list\">\n        <li>\n\n                    <a href=\"/safety/recalls-market-withdrawals-safety-alerts\" title=\"Recalls, Market Withdrawals, &amp; Safety Alerts\" class=\"lcds-section-nav__link lcds-section-nav--side__link lcds-section-nav__parent-link lcds-section-nav--side__parent-link\">\n                                        Recalls, Market Withdrawals, &amp; Safety Alerts\n                      </a>\n\n          \n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section view-id-in_this_section view-display-id-block_4 js-view-dom-id-74e893197f81c58917cf9abe0d3a58b810df84ff9b0e56c54ed2eb6df5373d04\">\n  \n    \n      \n  \n      <div class=\"item-list\">\n  \n  <ul class=\"lcds-section-nav__active lcds-section-nav__list lcds-section-nav--side__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/recall-resources\" class=\"lcds-section-nav__link lcds-section-nav--side__link\">Recall Resources </a></li>\n    \n  </ul>\n\n</div>\n\n\n  \n          </div>\n</div>\n\n\n                        <div class=\"views-element-container form-group\"><div class=\"view view-in-this-section-sub view-id-in_this_section_sub view-display-id-block_1 js-view-dom-id-5a1c862a65c3055df705bd4e4bdd660b89dc992eedcb798382b9da3294e00f64\">\n  \n    \n      \n      <div class=\"view-content\">\n      <div>\n  \n  <ul class=\"lcds-section-nav__list\">\n\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/enforcement-reports\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Enforcement Reports</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/industry-guidance-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Industry Guidance For Recalls</a></li>\n          <li><a href=\"/safety/recalls-market-withdrawals-safety-alerts/major-product-recalls\" class=\"lcds-section-nav__section-link lcds-section-nav__link lcds-section-nav--side__link\">Major Product Recalls</a></li>\n    \n  </ul>\n\n</div>\n\n    </div>\n  \n          </div>\n</div>\n\n\n        </li>\n      </ul>\n    </nav>\n  </div>\n\n  </section>\n\n\n                </aside>\n              \n                                                          \n              <div class=\"col-md-8\" role=\"main\">\n\n                            \n                            \n                            \n                            \n                                              \n  <h2>Summary</h2>\n\n  <div class=\"inset-column\">\n    <dl class=\"lcds-description-list--grid\">\n            <dt class=\"cell-1_1\">Company Announcement Date:</dt>\n             <dd class=\"cell-2_1\"><time datetime=\"2026-08-31T16:44:00Z\">August 31, 2026</time>\n</dd>\n\n                          <dt class=\"cell-1_2\">FDA Publish Date:</dt> \n               <dd class=\"cell-2_2\"><time datetime=\"2026-08-31T04:00:00Z\">August 31, 2026</time>\n</dd>\n                                    <dt class=\"cell-1_3\">Product Type:</dt> \n              <dd class=\"cell-2_3\">Food &amp; Beverages                          \n            \n            \n            \n            \n            \n            \n            \n              \n              <br/>Ingredients\n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          \n            \n            \n            \n              \n            \n            \n                          </dd>\n                          <dt class=\"cell-1_4\">Reason for Announcement:</dt>\n              <dd class=\"cell-2_4\">\n  <div class=\"field field--name-field-recall-reason-description field--type-string field--label-above\">\n    <div class=\"field--label\">Recall Reason Description</div>\n              <div class=\"field--item\">Contains garlic essential oil not approved for culinary use</div>\n          </div>\n</dd>\n\n            <dt class=\"cell-1_5\">Company Name:</dt> \n              <dd class=\"cell-2_5\">LMSI LLC</dd>\n\n            <dt class=\"cell-1_6\">Brand Name:</dt>\n              <dd class=\"cell-2_6\">\n  <div class=\"field field--name-field-brand-name field--type-entity-reference field--label-inline\">\n    <div class=\"field--label\">Brand Name(s)</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Kofinas</div>\n              </div>\n      </div>\n</dd>\n\n            <dt class=\"cell-1_7\">Product Description:</dt>\n              <dd class=\"cell-2_7\">\n  <div class=\"field field--name-field-product-description field--type-string field--label-above\">\n    <div class=\"field--label\">Product Description</div>\n          <div class=\"field--items\">\n              <div class=\"field--item\">Garlic Mediterranean Infused Extra Virgin Olive Oil 500 ml, 250 ml, and 100 ml</div>\n              </div>\n      </div>\n</dd> \n        </dl>\n      </div>   \n<hr>\n\n  <h2 id=\"recall-announcement\">Company Announcement</h2>\n\n\n\n<p><strong>Cincinnati, OH (Aug. 29, 2026)</strong> - LMSI LLC/ Kofinas Olive Oil is issuing a voluntary recall of its Garlic Mediterranean infused extra virgin olive oil for using a garlic essential oil not approved for culinary use. The flavored oil was bottled in glass bottles in 500 ml, 250 ml, and 100 ml sizes.</p><p>The recalled products were available for sale from August 31, 2025, to August 27, 2026, at the following locations:</p><p>Montgomery Store &amp; Infusion Kitchen: 8210 Market Place Ln., Cincinnati, OH 45242</p><p>Findlay Market: 1801 Race St., Cincinnati, OH 45202</p><p>Online sales directly from <a href=\"https://links-1.govdelivery.com/CL0/http:%2F%2Fwww.kofinasoliveoil.com/1/010001a04ce7dcef-7dcd21a5-52bb-4052-b7bc-326932255893-000000/IWuBZAZ6HbrJh350LH0DMtDZVYXhnrVvec08x6TRLwY=452\">www.kofinasoliveoil.com</a>.</p><p>There have been no reports of illnesses involving the products addressed in this recall. Individuals exhibiting signs or symptoms of an allergic reaction or food-borne illness should contact a physician immediately.</p><p>If any customer though will report any reaction to the oil will receive full refund.</p><p>Questions should be addressed at the number: 513-325-5502 or 513-981-1412.</p><p>Thank you in advance for your cooperation.</p>\n\n\n\n\n<div class=\"inset-column\">\n      <hr>\n    <h2>Company Contact Information</h2>\n  \n  \n    <div class=\"row\">\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n          <dt>Consumers:</dt>       \n\n        \n                 <dd><span class=\"fa fa-phone\" aria-hidden=\"true\"></span> 513-325-5502 or 513-981-1412</dd>\n        \n        \n        \n\n      </dl>\n    </div>\n    <div class=\"col-xs-12 col-md-6\">\n      <dl>\n\n      \n      \n      \n      \n      </dl>\n    </div>\n  </div>\n  </div>\n\n\n\n  <hr>\n  <div id=\"recall-photos\" class=\"recall-photos lazy-load\">\n    <h2>Product Photos</h2>\n\n            <ul class=\"list-unstyled nav-stacked\">\n        \n    <li>\n    \t<figure>\n    \t\t<div>\n  \n  \n            <div class=\"field field--name-image field--type-image field--label-hidden field--item\">    <picture>\n                  <source srcset=\"/files/styles/recall_image_small/public/picture1recall.jpg?itok=qES3COfB 480w\" media=\"all and (max-width: 320px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"639\"/>\n              <source srcset=\"/files/styles/recall_image_small/public/picture1recall.jpg?itok=qES3COfB 480w\" media=\"all and (min-width: 321px) and (max-width: 480px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"480\" height=\"639\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/picture1recall.jpg?itok=qm66hwKh 1020w\" media=\"all and (min-width: 481px) and (max-width: 767px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/picture1recall.jpg?itok=qm66hwKh 1020w\" media=\"all and (min-width: 768px) and (max-width: 992px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/picture1recall.jpg?itok=qm66hwKh 1020w\" media=\"all and (min-width: 993px) and (max-width: 1200px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n              <source srcset=\"/files/styles/recall_image_large/public/picture1recall.jpg?itok=qm66hwKh 1020w\" media=\"all and (min-width: 1201px)\" type=\"image/jpeg\" sizes=\"100vw\" width=\"1020\" height=\"1359\"/>\n                  <img loading=\"eager\" src=\"/files/styles/recall_image_small/public/picture1recall.jpg?itok=qES3COfB\" width=\"480\" height=\"639\" alt=\"Kofinas Garlic Mediterranean Infused Extra Virgin Olive Oil Front Label\" class=\"img-responsive\" />\n\n  </picture>\n\n</div>\n      \n</div>\n\n    \t</figure>\n    </li>\n\n      </ul>\n      \n  </div>\n\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n<!--BEGIN QUALTRICS WEBSITE FEEDBACK SNIPPET-->\n\n\n\n              \n                                            \n              \n            </div>\n\n                                                  \n                          <aside
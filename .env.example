# Copy to .env and fill in values from your Supabase project
# (Dashboard → Project Settings → API Keys / Data API). Never commit .env.

# ── Client-safe (bundled into the Expo app) ──────────────────────────────────
# The publishable key is designed to be public; Row Level Security limits it
# to read-only access on the recall feed.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The RevenueCat PUBLIC iOS SDK key (RevenueCat → Project → API keys → the
# Apple App Store app's public key). It identifies the app to the store and
# grants nothing. A build without it runs the fail-closed purchase provider:
# the paywall shows its could-not-confirm state and no purchase can occur.
# Leave it unset locally unless you are testing the real store.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...

# ── Server-only (used by the jobs:* scripts; NEVER in the app) ───────────────
# The secret key bypasses Row Level Security. Keep it out of the mobile
# bundle, out of git, and out of any EXPO_PUBLIC_* variable.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional, server-only: set ONLY if "enhanced push security" is enabled on
# the Expo account (expo.dev → Access tokens). Never in the app bundle.
# EXPO_ACCESS_TOKEN=...

# Server-only: the alert entitlement gate (push worker, `jobs:push` only).
# A RevenueCat REST API v2 secret key scoped to customer_information:customers:read,
# the RevenueCat project id, and the internal id of the `premium` entitlement.
# Production values live ONLY in the GitHub `production` environment; never in
# EAS, never in the app bundle. Unset = every alert is held (fail closed).
# REVENUECAT_SECRET_KEY=...
# REVENUECAT_PROJECT_ID=proj...
# REVENUECAT_PREMIUM_ENTITLEMENT_ID=entl...

# Server-only: the scheduler-watchdog shared secret, used ONLY by
# `npm run scheduler:probe` to authenticate against the ingest-watchdog Edge
# Function. Same value the founder stored in Vault (watchdog_shared_secret)
# and as the function secret WATCHDOG_SHARED_SECRET. The GitHub Actions token
# is NEVER configured locally — it exists only as an Edge Function secret.
# WATCHDOG_SHARED_SECRET=...
